+    async function openHttpProxySettings(proto = 'http_proxy') {
+        try {
+            const data = await apiCall(`/api/servers/${SERVER_ID}/http-proxy/credentials?protocol=${encodeURIComponent(proto)}`);
+            document.getElementById('httpProxySetPort').value = data.port || 4769;
+            document.getElementById('httpProxySetUser').value = data.username || 'bw';
+            document.getElementById('httpProxySetPass').value = data.password || '';
+            window.currentHttpProxyProto = proto;
+            openModal('httpProxySettingsModal');
+        } catch (err) {
+            showToast(_('error') + ': ' + err.message, 'error');
+        }
+    }
+
+    async function saveHttpProxySettings() {
+        const btn = document.getElementById('httpProxySaveBtn');
+        const label = document.getElementById('httpProxySaveBtnText');
+        const spinner = document.getElementById('httpProxySaveSpinner');
+        const port = parseInt(document.getElementById('httpProxySetPort').value, 10);
+        const username = document.getElementById('httpProxySetUser').value.trim();
+        const password = document.getElementById('httpProxySetPass').value;
+        if (!Number.isInteger(port) || port < 1 || port > 65535 || !username || !password) {
+            showToast('Enter a valid port, username and password', 'error');
+            return;
+        }
+        btn.disabled = true;
+        label.textContent = _('saving') || 'Saving...';
+        spinner.classList.remove('hidden');
+        try {
+            const result = await apiCall(`/api/servers/${SERVER_ID}/http-proxy/credentials`, 'POST', {
+                protocol: window.currentHttpProxyProto || 'http_proxy', port, username, password
+            });
+            if (result.status !== 'success') throw new Error(result.message || result.error || 'Could not save settings');
+            closeModal('httpProxySettingsModal');
+            showToast('HTTP proxy settings saved', 'success');
+            setTimeout(() => checkServer(), 500);
+        } catch (err) {
+            showToast(_('error') + ': ' + err.message, 'error');
+        } finally {
+            btn.disabled = false;
+            label.textContent = _('save');
+            spinner.classList.add('hidden');
+        }
+    }
