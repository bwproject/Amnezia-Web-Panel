+            (state.options || []).forEach(item => {
+                const option = document.createElement('option');
+                option.value = item.protocol;
+                option.textContent = item.label;
+                if (state.telemt_exit && state.telemt_exit.awg_protocol === item.protocol) option.selected = true;
